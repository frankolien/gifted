# Browser app. `npm run demo --prefix app` writes app/.env.local for you on a local chain.
# For a testnet deployment, copy this file to app/.env.local and fill in the addresses.
VITE_BROKER_ADDRESS=
VITE_STABLE_ADDRESS=
VITE_ASSET_ADDRESS=
VITE_STABLE_DECIMALS=18
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com
VITE_CHAIN_ID=46630
VITE_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# true enables the faucet, price and time controls and the no-wallet demo account.
# Those extras only appear when VITE_RPC_URL is localhost.
VITE_DEMO_MODE=false

# Keeper process (set in its environment; never commit the value)
BROKER_ADDRESS=
KEEPER_PRIVATE_KEY=
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
KEEPER_INTERVAL_MS=60000
