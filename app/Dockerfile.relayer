# GiFTED! relayer: keeper + live prices + gas sponsor. Configure with the variables documented in server/relayer.js.
FROM node:22-alpine
WORKDIR /srv
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY server ./server
ENV NODE_ENV=production PORT=8788
EXPOSE 8788
USER node
CMD ["node", "server/relayer.js"]
